# Speech bubbles for comics, storyboards and user journeys.
# Use it with: import say, think, whisper, shout, caption from shapes.speech
#
# `say`, `think` and `whisper` point at any spot: `tip-x` and `tip-y` are where the tip
# is, measured from the middle of the bubble (negative is left or up).
# So `say(tip-x=-50, tip-y=60)` points down and to the left, `say(tip-x=120, tip-y=0)` right.
# `text-size` sets the size of the words in every bubble except `caption`.

export say, think, whisper, shout, caption

speech is style(font-size=14, fill=#1a1a1a)

# A rounded bubble with a pointed tail.
# The tail runs from the middle of the bubble to the tip, so it comes out on the side facing
# the tip. It is drawn behind the bubble; `cover`, drawn on top without a border, hides the
# bubble's border where the tail leaves it. The tail's border is 4 wide because `cover`
# hides its inner half.
say is shape(label, width=160, height=70, text-size=14, tip-x=-50, tip-y=60, color=white, line=#333333):
  tip is polygon(points="(width / 2 - tip-y * 0.15),(height / 2 + tip-x * 0.15) (width / 2 + tip-x),(height / 2 + tip-y) (width / 2 + tip-y * 0.15),(height / 2 - tip-x * 0.15)", fill=color, stroke=line, stroke-width=4)
  body is rect(width=100%, height=100%, radius=16, fill=color, stroke=line, stroke-width=2)
  cover is polygon(points="(width / 2 - tip-y * 0.15),(height / 2 + tip-x * 0.15) (width / 2 + tip-x),(height / 2 + tip-y) (width / 2 + tip-y * 0.15),(height / 2 - tip-x * 0.15)", fill=color)
  words is text(label, x=50%, y=(height - text-size) / 2, align=middle, style=speech, font-size=text-size)

# An oval with two small bubbles. The small one is at the tip, the big one most of the way there.
think is shape(label, width=160, height=80, text-size=14, tip-x=-50, tip-y=60, color=white, line=#333333):
  small is circle(x=width / 2 + tip-x - 5, y=height / 2 + tip-y - 5, r=5, fill=color, stroke=line, stroke-width=2)
  big is circle(x=width / 2 + tip-x * 0.8 - 9, y=height / 2 + tip-y * 0.8 - 9, r=9, fill=color, stroke=line, stroke-width=2)
  body is ellipse(x=0, y=0, rx=width / 2, ry=height / 2, fill=color, stroke=line, stroke-width=2)
  words is text(label, x=50%, y=(height - text-size) / 2, align=middle, style=speech, font-size=text-size)

# A dashed bubble with italic words, aimed like `say`.
whisper is shape(label, width=160, height=70, text-size=14, tip-x=-50, tip-y=60, color=white, line=#666666):
  tip is polygon(points="(width / 2 - tip-y * 0.15),(height / 2 + tip-x * 0.15) (width / 2 + tip-x),(height / 2 + tip-y) (width / 2 + tip-y * 0.15),(height / 2 - tip-x * 0.15)", fill=color, stroke=line, stroke-width=4, stroke-dasharray="4 3")
  body is rect(width=100%, height=100%, radius=16, fill=color, stroke=line, stroke-width=2, stroke-dasharray="4 3")
  cover is polygon(points="(width / 2 - tip-y * 0.15),(height / 2 + tip-x * 0.15) (width / 2 + tip-x),(height / 2 + tip-y) (width / 2 + tip-y * 0.15),(height / 2 - tip-x * 0.15)", fill=color)
  words is text(label, x=50%, y=(height - text-size) / 2, align=middle, style=speech, font-size=text-size, font-style=italic)

# A burst for loud words. Its points follow `width` and `height`; `text-size` is the size of the words.
shout is shape(label, width=160, height=88, text-size=14, color=#fff3b0, line=#333333):
  burst is polygon(points="(0 * width / 160),(0 * height / 88) (32 * width / 160),(16 * height / 88) (44 * width / 160),(0 * height / 88) (64 * width / 160),(18 * height / 88) (88 * width / 160),(4 * height / 88) (100 * width / 160),(22 * height / 88) (120 * width / 160),(8 * height / 88) (132 * width / 160),(24 * height / 88) (160 * width / 160),(20 * height / 88) (140 * width / 160),(40 * height / 88) (160 * width / 160),(60 * height / 88) (132 * width / 160),(60 * height / 88) (148 * width / 160),(80 * height / 88) (116 * width / 160),(72 * height / 88) (108 * width / 160),(88 * height / 88) (88 * width / 160),(72 * height / 88) (68 * width / 160),(88 * height / 88) (56 * width / 160),(72 * height / 88) (28 * width / 160),(84 * height / 88) (32 * width / 160),(64 * height / 88) (0 * width / 160),(64 * height / 88) (20 * width / 160),(44 * height / 88)", fill=color, stroke=line, stroke-width=2)
  words is text(label, x=50%, y=(height - text-size) / 2, align=middle, style=speech, font-size=text-size, font-weight=bold)

# A box for the narrator.
caption is shape(label, width=160, height=40, color=#fff8dc, line=#333333):
  body is rect(width=100%, height=100%, fill=color, stroke=line, stroke-width=2)
  words is text(label, x=10, y=(height - 14) / 2, style=speech)

# Example uses, shown when this library is open in ZyxDraw. Drawings never draw them.
preview():
  say(label="Hello!")
  say(label="Up and right", tip-x=110, tip-y=-70)
  say(label="To the left", tip-x=-130, tip-y=0, text-size=18)
  think(label="Hmm...")
  think(label="Over there", tip-x=105, tip-y=-45, text-size=12)
  whisper(label="psst")
  whisper(label="a secret", tip-x=125, tip-y=20)
  shout(label="WOW!")
  shout(label="A wide shout!", width=240, height=70, text-size=18)
  caption(label="Meanwhile...")
