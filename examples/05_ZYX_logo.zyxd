# New ZyxDraw drawing
# Drawing a logo with polygons. Planned as Zyx logo earlier, but now using 04_zoey_nyxx_logo.zyxd as logo for ZyxDraw.
canvas(width=200, height=200)

# polygon zoey_left(fill=#fbb904, points="10,10 10,90 90,10")
# polygon zoey_right(fill=#fbb904, points="110,10 110,90 30,90")
# polygon nyxx_left(fill=#31bbec, points="120,10, 120,100 190,100")

red_zx is polygon(
  fill=red
  points="10,10 100,10 100,30 35,90 100,90 150,172 190,172 190,190 140,190 90,110 10,110 10,90 75,30 10,30"
)
blue_yx is polygon(
  fill=rgb(50,235,255)
  points="100,10 110,10 145,55 180,10 190,10 190,30 154,75 154,110 90,191.3 10,190.8 10,172 85,172 136,110 136,75 100,30"
)
