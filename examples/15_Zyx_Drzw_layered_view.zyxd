canvas(width=1000, height=600)

outer_frame is style(fill=white, stroke=#555)

frame_box is shape(look=outer_frame, label="text"):
  border is rect(width=100%, height=100%, style=look)
  caption is text(label, left=20, top=20)

left_panel is frame_box(label="Left panel", left=0, top=0, width=25%, height=100%)
right_panel is frame_box(label="Right panel", right=0, top=0, width=25%, height=100%)
drawing_area is frame_box(label="Drawing area", left=25%, width=50%, height=75%)
bottom_panel is frame_box(label="Properties", top=75%, left=25%, width=50%, height=25%)
