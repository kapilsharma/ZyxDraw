# New ZyxDraw drawing
canvas(width=100, height=100)

sky is gradient(angle=0):
  stop(offset=0%, color=#F00)
  stop(offset=50%, color=#0F0)
  stop(offset=100%, color=#00F)
box is rect(width=90, height=15, fill=sky, x=5, y=5)

sky2 is gradient(from=white, to=steelblue, angle=0)
box2 is rect(width=90, height=15, fill=sky2, x=5, y=20)

path_test is path(d="M 18,51 C 18.1,51.5 28,42.1 35,47.1 C 41.5,51.7 42,45.4 52.8,46.1 C 57.9,46.1 59.0,57.6 50.9,59.7 C 45.1,61.2 38,61.2 38,61.2  L 17.8,61.2", fill=none, stroke=black, x=2.9%, y=-6%)
