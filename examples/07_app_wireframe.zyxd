# Nested groups: an app window, three groups deep.
#
# Try selecting in the drawing:
#   - Click the orange avatar: `app` is selected (the outermost group).
#   - Click it again: `main`. Again: `profile`. Again: `avatar`, the shape itself.
#   - Double-click the avatar: `avatar` straight away.
#   - Click a menu item: `app`, then `sidebar`, then the item.
# Moving a group moves everything inside it; only that group's x / y change in the text.
canvas(width=480, height=300, background=white)

panel is style(fill=#f4f6f8, stroke=#c8cdd3, rx=6)
item is style(fill=white, stroke=#c8cdd3, rx=4)

app is group(x=20, y=20, width=440, height=260):
  frame is rect(width=100%, height=100%, fill=white, stroke=#5b6470, stroke-width=2, rx=8)
  title is text("My app", x=16, y=12, font-size=16, font-weight=bold, fill=#2b3138)

  sidebar is group(x=12, y=44, width=110, height=204):
    rect(width=100%, height=100%, style=panel)
    home is rect(x=8, y=10, width=94, height=28, style=item)
    text("Home", x=18, y=17, fill=#2b3138)
    files is rect(below=home 8, x=8, width=94, height=28, style=item)
    text("Files", x=18, y=53, fill=#2b3138)
    settings is rect(below=files 8, x=8, width=94, height=28, style=item)
    text("Settings", x=18, y=89, fill=#2b3138)

  main is group(right-of=sidebar 12, y=44, width=294, height=204):
    rect(width=100%, height=100%, style=panel)

    profile is group(x=12, y=12, width=270, height=80):
      card is rect(width=100%, height=100%, style=item)
      avatar is circle(cx=40, cy=40, r=24, fill=orange)
      name is text("Zoey Nyxx", x=78, y=22, font-size=15, font-weight=bold, fill=#2b3138)
      role is text("Author", x=78, y=46, fill=#5b6470)

    chart is group(below=profile 12, x=12, width=270, height=88):
      rect(width=100%, height=100%, style=item)
      rect(x=20, y=48, width=30, height=28, fill=#31bbec)
      rect(x=70, y=28, width=30, height=48, fill=#31bbec)
      rect(x=120, y=12, width=30, height=64, fill=#fbb904)
      rect(x=170, y=36, width=30, height=40, fill=#31bbec)
      rect(x=220, y=20, width=30, height=56, fill=#31bbec)
