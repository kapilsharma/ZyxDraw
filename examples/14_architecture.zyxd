# A palace: a main hall, two wings, two tall towers and two small ones.
# Built back to front: towers, wings, hall, roofs, windows, garden.
# Windows, bricks, trees and bushes are custom shapes; the roofs and the sky use gradients.
canvas(width=600, height=450, background=sky)

# Gradients
sky is gradient(from=#dff1f8, to=white, angle=90)
roof_tiles is gradient(from=#f6a04a, to=#d9661f, angle=90)
lawn is gradient(from=#6cc070, to=#3a8f4a, angle=90)

# Colors
wall is style(fill=#eeeae4)
wall_shade is style(fill=#d9d3cc)
roof is style(fill=roof_tiles)
roof_edge is style(fill=#c4561a)
brick is style(fill=#d6d0c8)
spire is style(stroke=#e07a2a, stroke-width=3)

# Reusable pieces
window_pair is shape(color=#c25a24):
  left is path(d="M 0,26 L 0,7 A 5,5 0 0 1 10,7 L 10,26 Z", fill=color)
  right is path(d="M 13,26 L 13,7 A 5,5 0 0 1 23,7 L 23,26 Z", fill=color)
  sill is rect(x=-3, y=26, width=29, height=3, fill=#f8f6f2)

slit is shape(color=#c25a24):
  path(d="M 0,16 L 0,4 A 4,4 0 0 1 8,4 L 8,16 Z", fill=color)

bricks is shape():
  rect(x=0, y=0, width=14, height=5, style=brick)
  rect(x=9, y=7, width=14, height=5, style=brick)
  rect(x=-3, y=14, width=10, height=5, style=brick)

tree is shape():
  trunk is rect(x=17, y=30, width=6, height=40, fill=#7a5236)
  crown is circle(cx=20, cy=20, r=20, fill=#5cb85c)
  shade is circle(cx=24, cy=24, r=9, fill=#3e9b46)

bush is shape(color=#4caf50):
  circle(cx=14, cy=16, r=14, fill=color)
  circle(cx=34, cy=11, r=15, fill=color)
  circle(cx=54, cy=17, r=12, fill=color)
  rect(x=2, y=16, width=62, height=12, fill=color)

# Tall towers, behind everything
tower_left is rect(x=168, y=110, width=40, height=200, style=wall_shade)
tower_left_roof is polygon(points="188,38 214,110 162,110", style=roof)
tower_left_spire is line(x1=188, y1=14, x2=188, y2=40, style=spire)
tower_left_flag is polygon(points="188,14 204,19 188,24", fill=#d64541)
tower_right is rect(x=392, y=110, width=40, height=200, style=wall_shade)
tower_right_roof is polygon(points="412,38 438,110 386,110", style=roof)
tower_right_spire is line(x1=412, y1=14, x2=412, y2=40, style=spire)
tower_right_flag is polygon(points="412,14 428,19 412,24", fill=#d64541)
slit1 is slit(x=184, y=126)
slit2 is slit(x=184, y=160)
slit3 is slit(x=408, y=126)
slit4 is slit(x=408, y=160)

# Small towers at the corners
turret_left is rect(x=100, y=170, width=30, height=90, style=wall_shade)
turret_left_roof is polygon(points="115,128 136,172 94,172", style=roof)
turret_left_spire is line(x1=115, y1=114, x2=115, y2=130, style=spire)
turret_right is rect(x=470, y=170, width=30, height=90, style=wall_shade)
turret_right_roof is polygon(points="485,128 506,172 464,172", style=roof)
turret_right_spire is line(x1=485, y1=114, x2=485, y2=130, style=spire)
slit5 is slit(x=111, y=186)
slit6 is slit(x=481, y=186)

# Left wing, with a little gable on its roof
wing_left is rect(x=90, y=255, width=125, height=145, style=wall)
gable_left is rect(x=138, y=190, width=28, height=24, style=wall)
gable_left_roof is polygon(points="133,193 152,172 171,193", style=roof)
slit7 is slit(x=148, y=196, scale=0.8)
wing_left_roof is polygon(points="80,258 225,258 200,208 105,208", style=roof)
wing_left_eave is rect(x=80, y=255, width=145, height=5, style=roof_edge)
wing_left_band is rect(x=90, y=322, width=125, height=5, style=wall_shade)
win1 is window_pair(x=110, y=280)
win2 is window_pair(x=172, y=280)
win3 is window_pair(x=110, y=345)
win4 is window_pair(x=172, y=345)

# Right wing
wing_right is rect(x=385, y=255, width=125, height=145, style=wall)
gable_right is rect(x=434, y=190, width=28, height=24, style=wall)
gable_right_roof is polygon(points="429,193 448,172 467,193", style=roof)
slit8 is slit(x=444, y=196, scale=0.8)
wing_right_roof is polygon(points="375,258 520,258 495,208 400,208", style=roof)
wing_right_eave is rect(x=375, y=255, width=145, height=5, style=roof_edge)
wing_right_band is rect(x=385, y=322, width=125, height=5, style=wall_shade)
win5 is window_pair(x=405, y=280)
win6 is window_pair(x=467, y=280)
win7 is window_pair(x=405, y=345)
win8 is window_pair(x=467, y=345)

# Main hall: two dormers behind its roof
dormer_left is rect(x=228, y=150, width=44, height=40, style=wall)
dormer_left_roof is polygon(points="222,153 250,122 278,153", style=roof)
dormer_left_win is window_pair(x=239, y=156, scale=0.8)
dormer_right is rect(x=328, y=150, width=44, height=40, style=wall)
dormer_right_roof is polygon(points="322,153 350,122 378,153", style=roof)
dormer_right_win is window_pair(x=339, y=156, scale=0.8)
hall is rect(x=205, y=215, width=190, height=185, style=wall)
hall_roof is polygon(points="195,218 405,218 385,182 215,182", style=roof)
hall_eave is rect(x=195, y=215, width=210, height=6, style=roof_edge)
hall_band1 is rect(x=205, y=272, width=190, height=5, style=wall_shade)
hall_band2 is rect(x=205, y=326, width=190, height=5, style=wall_shade)
win9 is window_pair(x=225, y=236)
win10 is window_pair(x=288, y=236)
win11 is window_pair(x=352, y=236)
win12 is window_pair(x=225, y=290)
win13 is window_pair(x=288, y=290)
win14 is window_pair(x=352, y=290)
win15 is window_pair(x=225, y=350)
win16 is window_pair(x=352, y=350)

# Front door and steps
door is path(d="M 282,400 L 282,362 A 18,18 0 0 1 318,362 L 318,400 Z", fill=#8a3d18)
door_frame is path(d="M 278,400 L 278,362 A 22,22 0 0 1 322,362 L 322,400", fill=none, stroke=#d9d3cc, stroke-width=4)
steps is rect(x=268, y=396, width=64, height=6, style=wall_shade)

# Worn bricks on the walls
bricks1 is bricks(x=96, y=300)
bricks2 is bricks(x=190, y=365)
bricks3 is bricks(x=250, y=258)
bricks4 is bricks(x=330, y=310)
bricks5 is bricks(x=390, y=360)
bricks6 is bricks(x=485, y=300)
bricks7 is bricks(x=176, y=240)
bricks8 is bricks(x=398, y=150)

# Garden
ground is rect(x=0, y=398, width=600, height=52, fill=lawn)
path_stones is polygon(points="286,402 314,402 336,450 264,450", fill=#e6dccf)
tree_left is tree(x=22, y=330)
tree_right is tree(x=538, y=330)
bush1 is bush(x=60, y=378)
bush2 is bush(x=150, y=384, scale=0.8)
bush3 is bush(x=400, y=384, scale=0.8)
bush4 is bush(x=478, y=378)
